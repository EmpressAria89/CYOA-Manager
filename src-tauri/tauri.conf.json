{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CYOA Manager",
  "version": "0.1.8",
  "identifier": "com.om1cr0n.cyoa-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5697",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CYOA Manager — Linux",
        "width": 1100,
        "height": 700,
        "maximized": false,
        "backgroundColor": "#1e1e2e",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": {
      "../public/viewers": "viewers"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
