{
  "name": "cyoa-manager",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:linux": "pnpm build && cargo build --release --features custom-protocol --manifest-path src-tauri/Cargo.toml && python3 tests/check-release-assets.py",
    "test:rust": "cargo test --release --features custom-protocol --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node tests/run-ui.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "1.62.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
